  "commit_rule": {
    "mode": "two_fold_train_inner_dev_cross_fit",
    "fold": "int.from_bytes(sha256((paired_group_id + ':endpoint-probe-fold').encode('utf-8')).digest()[:8], 'big') % 2",
    "calibrate_on_opposite_fold": true,
    "shared_across": ["A", "C", "E"],
    "seed_weighting": "equal_within_complete_paired_group",
    "selection": "existing_lexicographic_one_step_active_correctness_then_fact_error_then_false_birth_then_higher_commit_rate",
