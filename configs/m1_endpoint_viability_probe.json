  },
  "endpoints": {
    "exact": {
      "metric": "final_active_graph_correctness",
      "definition": "exact_equality_of_active_node_and_edge_semantic_multisets"
    },
    "graded": {
      "metric": "final_graded_active_world_correctness",
      "definition": "multiset_jaccard_intersection_over_union_on_the_same_active_node_and_edge_records_as_exact",
      "node_fields": ["node_id", "node_type", "lifecycle", "canonical_id", "latent_refs"],
      "edge_fields": ["source", "target", "relation", "frame"],
      "duplicate_records_preserved": true,
      "exact_equivalence": "graded_equals_1_if_and_only_if_exact_equals_1",
      "meaningful_effect_absolute": 0.03,
      "threshold_semantics": "three_percentage_points_more_relative_active_record_overlap;_newly_registered_not_inherited_from_binary_scale"
    },
    "open_memory_support": {
      "metric": "final_graded_open_memory_correctness",
      "definition": "multiset_jaccard_on_open_node_and_edge_records_including_evidence_refs",
      "exact_equivalence": "graded_open_memory_equals_1_if_and_only_if_open_memory_correct_equals_1",
      "meaningful_effect_absolute": 0.03,
      "required_co_primary_for_both_A_vs_C_and_A_vs_E": true,
      "reason": "active_semantics_and_edge_only_fact_counts_cannot_observe_evidence_only_BIND_or_unrelated_evidence_attachment_damage"
    }
  },
  "oracle_integrity_gate": {
    "all_F_groups_require": {
      "final_active_graph_correctness": 1.0,
      "final_graded_active_world_correctness": 1.0,
      "final_graded_open_memory_correctness": 1.0,
      "active_node_state_error_per_100": 0.0
    },
    "failure_action": "abort_without_endpoint_switch_or_budget_grid"
  },
  "nondegeneracy_and_one_time_switch": {
    "unit": "complete_paired_group_after_equal_averaging_over_two_siblings_and_five_seeds",
    "contrasts": ["A_vs_C", "A_vs_E"],
    "absolute_difference_tolerance": 1e-12,
    "minimum_nonzero_group_rule": "ceil(0.03 * inner_dev_paired_groups)",
    "minimum_nonzero_groups_at_n_201": 7,
    "sample_standard_deviation_must_be_positive": true,
    "retain_exact_when_both_contrasts_nondegenerate": true,
    "switch_globally_to_graded_when_any_exact_contrast_degenerate_and_both_graded_contrasts_nondegenerate": true,
    "winner_identity_effect_direction_and_effect_size_forbidden_for_switch": true,
    "graded_failure_action": "stop_and_open_new_decision_without_searching_another_endpoint"
  },
  "power_planning": {
    "null_boundary_minimum_effect": 0.03,
    "planning_true_effect": 0.06,
    "one_sided_alpha_per_primary_contrast": 0.025,
    "z_one_sided_alpha": 1.959963984540054,
    "target_power": 0.8,
    "z_power": 0.8416212335729143,
    "formula": "ceil((((z_one_sided_alpha + z_power) * paired_group_sd) / (planning_true_effect - null_boundary_minimum_effect)) ** 2)",
    "minimum_test_paired_groups": 200,
    "round_up_to_multiple": 10,
    "take_maximum_across_primary_contrasts_and_selected_semantic_plus_open_memory_support_endpoints": true,
    "registered_test_size_cap": null,
    "test_is_not_generated_until_result_is_frozen": true
  },
  "always_on_reporting_and_safety": {
