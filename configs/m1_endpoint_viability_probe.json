  "training_anchor": {
    "architecture": "cross_candidate_set_transformer_v1",
    "methods": ["A", "C", "E"],
    "oracle": "F",
    "seeds": [7, 19, 31, 43, 59],
    "learning_rate": 0.0006,
    "student_updates": 3000,
    "e_outcome_scorer_learning_rate": 0.0006,
