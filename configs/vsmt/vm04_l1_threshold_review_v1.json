{
  "version": "vsmt-vm04-l1-threshold-review-v1",
  "status": "selection_protocol_approved_implementation_only",
  "decision": "D-139_D-140",
  "formal_values_frozen": false,
  "may_be_consumed_by_generation_or_training_runner": false,
  "scope": {
    "reviewed_modules": [
      "public_bootstrap",
      "VSMT_public_candidate_generator",
      "TAF",
      "ELU",
      "WFR",
      "LOW",
      "PHR_internal_control"
    ],
    "does_not_authorize": [
      "house_generation",
      "threshold_selection_from_private_or_confirmation_data",
      "training",
      "validation_effect_measurement",
      "confirmation_generation_or_reveal"
    ]
  },
  "audit_findings": [
    {
      "finding_id": "T-01-test-values-are-fixtures",
      "finding": "Values such as visual_weight=0.7, bind_threshold=0.6, duplicate_threshold=0.9 and maximum_candidates_per_bucket=20 occur only in branch tests or synthetic smoke configuration and are not formal experiment values."
    },
    {
      "finding_id": "T-02-one-score-crosses-structure-kinds",
      "finding": "The previous implementation applied one visual-weighted centroid score across structure kinds; the approved implementation excludes place from learned association and requires explicit entity, surface and fragment rules."
    },
    {
      "finding_id": "T-03-ranking-score-is-discarded",
      "finding": "The generator uses an unsealed score only to truncate candidates within each template and then discards it, while the proposed PHR control requires a frozen public decision score."
    },
    {
      "finding_id": "T-04-noop-score-is-not-a-decision-score",
      "finding": "NOOP is assigned 1.0 during within-template enumeration. Reusing that value across templates would force NOOP to beat every non-NOOP candidate below 1.0."
    },
    {
      "finding_id": "T-05-cap-does-not-bound-pre-cap-memory",
      "finding": "The previous maximum_candidates_per_template truncated only after materialization; the approved implementation uses bounded template-by-subject buckets and treats every SPLIT relation-assignment family as an indivisible group."
    },
    {
      "finding_id": "T-06-label-sensitive-selection-depends-on-semantics",
      "finding": "Final bootstrap, association and candidate-recall choices depend on the still-unfrozen S-01 to S-12 identity, equivalence and error policies, so exact values cannot be scientifically selected in the current review."
    }
  ],
  "recommended_protocol": {
    "association_evidence": {
      "record_components_separately": [
        "cosine_similarity_mapped_to_0_1",
        "centroid_distance_m",
        "geometry_proximity_0_1",
        "structure_kind",
        "public_reliability"
      ],
      "hard_same_structure_kind_gate": true,
      "structure_kind_specific_weights_scales_and_thresholds": true,
      "single_global_entity_surface_place_fragment_score": false,
      "formal_numeric_values": null
    },
    "fair_tuning": {
      "same_train_validation_families": true,
      "same_frozen_primary_selection_metric": true,
      "same_maximum_complete_configurations_per_method": 12,
      "method_specific_values_allowed": true,
      "unused_trials_need_not_be_spent": true,
      "bootstrap_selected_once_and_shared_byte_identically_in_controlled_revision": true,
      "VSMT_candidate_generator_is_a_separate_public_configuration": true,
