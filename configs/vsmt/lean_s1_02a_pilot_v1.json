  "failure_rules": {
    "failed_house_keeps_a_receipt": true,
    "failed_house_is_never_replaced": true,
    "kept_prefix_is_preserved": true,
    "planned_equals_succeeded_plus_failed": true,
    "pilot_failure_is_not_grounds_for_retrying_until_good": true,
    "plain_language_zh": "失败规则与 S0-02 完全一致，不在本阶段另立一套。额外加一条：pilot 失败不是「再试一次直到跑通」的理由——重试同一个 house 只有在失败原因是登记过的基础设施故障（例如 SSH 断线）且未产生任何部分产物时才允许，干预窗口不可用、动作被拒这类科学原因必须以失败告终。"
  },
