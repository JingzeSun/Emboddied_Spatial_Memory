  "status": "implementation_candidate_pending_user_code_review",
  "plain_language_zh": "本合同定义 S1-02a 这一步怎样才算合规：用 4 个 worker 各跑 1 个 house，把管线跑通，并实测单 worker 占用与 4 路并发是否安全。输入是已冻结的划分参数、house 池、pilot 计划与运行回执；输出是通过或拒绝，以及一份能喂给 S1-01 推导公式的占用读数。例如有人跑完看了结果觉得不好又重新生成同样 4 个 house，会被拒。它本身不启动模拟器、不生成 episode、不写任何数据面、不读 private，六个授权位全为 false；检查通过也不表示 pilot 已经跑过、CloudRendering 能起来或干预在科学上可构造。",
  "pure_core_relative_path": "src/vsmt/lean_pilot.py",
  "depends_on": {
    "s0_02_contract": "configs/vsmt/lean_s0_intervention_data_v2.json",
    "s1_01_contract": "configs/vsmt/lean_s1_assets_capacity_v2.json",
    "split_implementation": "src/vsmt/lean_intervention.py::assign_split",
    "worker_derivation": "src/vsmt/lean_assets.py::derive_worker_count",
    "ruling": "D-224-S1 裁决 14",
    "note_zh": "划分与 worker 推导都不在本阶段重写：house 分块直接调 S0-02 v2 的 `assign_split`，worker 数直接调 S1-01 v2 的 `derive_worker_count`。本阶段只负责「谁是 pilot 的 4 个 house、占用怎么量、回执必须写什么」。两处复用各有一项测试钉住，防止出现第二套划分或第二个公式。"
  },
  "authorization": {
    "split_freeze_registration": false,
    "house_pool_read": false,
    "simulator_start": false,
    "route_construction": false,
    "episode_generation": false,
    "occupancy_measurement": false
  },
  "must_remain_false": [
    "sample_replacement_on_failure",
    "regeneration_after_inspection",
    "house_selection_by_hand",
