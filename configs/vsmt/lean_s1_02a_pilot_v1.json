    "model_training",
    "route_template_change_after_first_episode"
  ],
  "split_freeze": {
    "seed": null,
    "validation_houses": null,
    "test_houses": null,
    "train_houses": null,
    "frozen_before_first_episode": true,
    "test_and_validation_membership_is_final": true,
    "train_size_may_only_decrease_afterwards": true,
    "development_houses_are_the_first_of_the_train_block": true,
    "recomputable_from_manifest": true,
    "plain_language_zh": "S0-02 v2 把前缀分配顺序改成 test→validation→train，于是 seed 与 test/validation 规模一旦定下，test 与 validation 的成员就永远不变，而 train 块的起点也随之固定。这三个值必须在第一条 episode 生成前冻结，本合同登记它们但当前为 null。`train_houses` 可以晚到 S3-01 再登记，且此后只能下调——下调只会从 train 块尾部截短，不碰前面任何一份。白话：先把答案卷封好再开始答题，而不是答完再决定哪些算考题。"
  },
  "pilot": {
    "workers": 4,
    "houses_per_worker": 1,
    "total_houses": 4,
    "house_selection": "first_four_of_the_train_block_by_split_key",
    "selection_is_deterministic_not_chosen": true,
    "counts_toward_the_development_fifty": true,
    "regeneration_after_inspection_forbidden": true,
    "plain_language_zh": "pilot 的 4 个 house 不是挑出来的，是按 S0-02 的划分键排序后 train 块最前面的 4 个，任何人换一个都会被重算抓到。这 4 条 episode **计入 S1 的 50 条开发样本**，不是热身后丢掉的草稿：跑完、看过结果、再重新生成同样的 house，等于按结果挑样本，因此被显式禁止。例如第 3 个 house 干预窗口不可用而失败，它就以失败回执的身份留在 50 条里，由 S1-02b 补足其余 46 个而不是另找一个好 house 顶上。"
  },
  "occupancy_measurement": {
    "measured_under_concurrency": 4,
    "concurrency_verified_at_is_not_the_derived_count": true,
    "derived_count_above_verified_concurrency_must_be_declared_an_extrapolation": true,
    "values": [
      "cpu_cores_per_worker",
      "ram_gb_per_worker",
      "vram_gb_per_worker",
      "disk_gb_per_worker",
      "simulator_concurrency_limit"
    ],
    "statistic": "peak_not_average",
    "workload": "a_full_episode_including_three_plane_write",
    "synthetic_microbenchmark_forbidden": true,
    "feeds": "configs/vsmt/lean_s1_assets_capacity_v2.json::worker_rule",
    "plain_language_zh": "五个量都取峰值而不是均值——按均值配出来的并发在高峰期会把机器挤爆；都在真实完整 episode（含三面写盘）上量，不许用合成小基准代替，因为模拟器启动与渲染才是大头。`simulator_concurrency_limit` 记的是「实测到 4 路并发安全」，它和后面算出来的 worker 数是两回事：算出来的数若大于 4，回执必须显式写明这是从单 worker 成本外推的，扩产后出现不稳定要如实报告，不得事后把数字悄悄改小当没发生。"
  },
  "receipts": {
    "pilot_receipt_fields": [
      "split_seed",
      "split_sizes",
      "selected_house_ids",
      "planned",
      "succeeded",
      "failed",
      "failure_receipts",
      "wall_clock_seconds",
      "exit_codes",
      "code_commit"
    ],
    "occupancy_receipt_fields": [
      "concurrency_verified_at",
      "cpu_cores_per_worker",
      "ram_gb_per_worker",
      "vram_gb_per_worker",
      "disk_gb_per_worker",
      "simulator_concurrency_limit",
      "statistic",
      "workload",
      "failures"
    ],
    "receipt_is_written_even_on_failure": true,
    "plain_language_zh": "两份回执各有固定字段：pilot 回执必须同时写下划分参数、被选中的 house、计划数、成功数、失败数与每份失败回执，因为「计划 4 条成功 3 条」必须恰好对应 1 份失败回执，否则说明有 episode 被静默丢弃；占用回执必须写清是在几路并发下量的、取的是峰值还是均值、跑的是什么负载。失败也必须留回执。"
  },
  "failure_reasons": [
    "house_load_failed",
    "route_not_placeable",
    "action_rejected",
    "intervention_window_unavailable",
    "intervention_execution_failed",
    "frame_write_failed"
