{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JingzeSun/Emboddied_Spatial_Memory/schemas/observation_graph.schema.json",
  "title": "Single-Frame Observation Graph",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "frame_id",
    "timestamp",
    "T_world_camera",
    "nodes",
    "edges",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "episode_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "number" },
    "T_world_camera": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "type": "number" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "provenance": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "observation_node_id",
        "node_type",
        "semantic_distribution",
        "visibility_evidence",
        "uncertainty"
      ],
      "properties": {
        "observation_node_id": { "type": "string", "minLength": 1 },
        "node_type": { "enum": ["object", "surface", "region"] },
        "image_support_ref": { "type": ["string", "null"] },
        "camera_geometry": { "type": ["object", "null"], "additionalProperties": true },
        "latent_ref": { "type": ["string", "null"] },
        "semantic_distribution": { "type": "object", "additionalProperties": true },
        "track_evidence": { "type": ["object", "null"], "additionalProperties": true },
        "visibility_evidence": { "type": "object", "additionalProperties": true },
        "motion_evidence": { "type": ["object", "null"], "additionalProperties": true },
        "uncertainty": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "observation_edge_id",
        "source_id",
        "target_id",
        "relation_type",
        "relation_family",
        "reference_frame",
        "confidence"
      ],
      "properties": {
        "observation_edge_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "relation_type": {
          "enum": [
            "located_in",
            "contains",
            "supports",
            "adjacent_to",
            "continuation_of",
            "near",
            "above",
            "below",
            "left_of",
            "right_of",
            "in_front_of",
            "behind",
            "occludes",
            "same_track"
          ]
        },
        "relation_family": {
          "enum": ["structural", "metric", "visibility", "temporal"]
        },
        "reference_frame": {
          "type": "object",
          "required": ["kind", "reference_id"],
          "properties": {
            "kind": { "enum": ["current_camera", "world", "gravity"] },
            "reference_id": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
