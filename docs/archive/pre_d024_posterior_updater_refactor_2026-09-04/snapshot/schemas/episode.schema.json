{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JingzeSun/Emboddied_Spatial_Memory/schemas/episode.schema.json",
  "title": "Affected-Subgraph Revision Episode",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "episode_id",
    "scene_id",
    "scene_family_id",
    "split",
    "counterfactual_group_id",
    "condition",
    "sensors",
    "initial_belief_graph_ref",
    "frames",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "contract_version": { "const": "1.1" },
    "episode_id": { "type": "string", "minLength": 1 },
    "scene_id": { "type": "string", "minLength": 1 },
    "scene_family_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["pilot", "train", "validation", "test"] },
    "counterfactual_group_id": { "type": "string", "minLength": 1 },
    "condition": {
      "enum": [
        "unchanged_visible",
        "viewpoint_or_turning_only",
        "transient_occlusion",
        "stationary_actor_short",
        "stationary_actor_long",
        "relocation_visible_destination",
        "reliable_absence_unknown_destination",
        "removed_from_scene",
        "out_of_fov",
        "irrelevant_innovation",
        "graph_expansion_corner_reveal",
        "same_category_discourse_shift",
        "sensor_inconsistency"
      ]
    },
    "random_seed": { "type": ["integer", "null"] },
    "coordinate_convention": { "const": "T_world_camera" },
    "initial_belief_graph_ref": { "type": "string", "minLength": 1 },
    "sensors": {
      "type": "object",
      "required": ["rgb", "depth", "pose", "camera_intrinsics"],
      "properties": {
        "rgb": { "const": true },
        "depth": { "type": "boolean" },
        "depth_source": { "type": ["string", "null"] },
        "depth_is_ground_truth": { "type": "boolean" },
        "pose": { "type": "boolean" },
        "pose_source": { "type": ["string", "null"] },
        "pose_is_ground_truth": { "type": "boolean" },
        "optical_flow": { "type": "boolean" },
        "semantics": { "type": "boolean" },
        "camera_intrinsics": {
          "type": "object",
          "required": ["fx", "fy", "cx", "cy", "width", "height"],
          "properties": {
            "fx": { "type": "number", "exclusiveMinimum": 0 },
            "fy": { "type": "number", "exclusiveMinimum": 0 },
            "cx": { "type": "number" },
            "cy": { "type": "number" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "frame_id",
          "timestamp",
          "rgb_path",
          "T_world_camera",
          "observation_graph_ref"
        ],
        "properties": {
          "frame_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "number" },
          "rgb_path": { "type": "string", "minLength": 1 },
          "depth_path": { "type": ["string", "null"] },
          "flow_path": { "type": ["string", "null"] },
          "T_world_camera": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": { "type": "number" }
          },
          "pose_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "depth_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "observation_graph_ref": { "type": "string", "minLength": 1 },
          "oracle_scene_graph_ref": { "type": ["string", "null"] },
          "oracle_context_delta_ref": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query_id", "query_type", "target_time", "expected_answer_ref"],
        "properties": {
          "query_id": { "type": "string" },
          "query_type": {
            "enum": [
              "where_is",
              "what_changed",
              "why_preserved",
              "what_occludes",
              "previous_place",
              "evidence_for",
              "find_referent",
              "resolve_ambiguous_referent"
            ]
          },
          "target_time": { "type": "number" },
          "expected_answer_ref": { "type": "string" },
          "raw_text": { "type": ["string", "null"] },
          "dialogue_history_ref": { "type": ["string", "null"] },
          "route_history_ref": { "type": ["string", "null"] },
          "active_context_ref": { "type": ["string", "null"] },
          "intent_annotation_status": {
            "enum": ["not_applicable", "unannotated", "human_annotated", "counterfactual_oracle"]
          }
        },
        "additionalProperties": true
      }
    },
    "asset_split_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "required": ["source", "license", "manifest_version", "generator_revision"],
      "properties": {
        "source": { "type": "string" },
        "license": { "type": "string" },
        "manifest_version": { "type": "string" },
        "generator_revision": { "type": "string" },
        "human_audit_status": { "enum": ["not_audited", "sampled", "fully_audited"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
