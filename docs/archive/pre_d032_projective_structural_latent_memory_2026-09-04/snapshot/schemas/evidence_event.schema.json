{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_event.schema.json",
  "title": "EvidenceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source_id", "observed_at", "received_at", "predicate", "subject", "polarity", "confidence", "visibility"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "number"},
    "received_at": {"type": "number"},
    "predicate": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "object": {"type": ["string", "null"]},
    "polarity": {"enum": ["positive", "negative", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "visibility": {"type": "number", "minimum": 0, "maximum": 1},
    "group_id": {"type": ["string", "null"]},
    "sensor_payload_ref": {"type": ["string", "null"]}
  }
}

