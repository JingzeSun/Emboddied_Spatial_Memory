{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JingzeSun/Emboddied_Spatial_Memory/schemas/context_delta.schema.json",
  "title": "Versioned Context Delta",
  "type": "object",
  "required": [
    "schema_version",
    "delta_id",
    "base_graph_version",
    "observation_graph_ref",
    "innovations",
    "affected_node_ids",
    "affected_edge_ids",
    "propagation_stop_edge_ids",
    "unchanged_control_ids",
    "operations",
    "confidence",
    "controller_revision",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "delta_id": { "type": "string", "minLength": 1 },
    "base_graph_version": { "type": "string", "minLength": 1 },
    "target_graph_version": { "type": ["string", "null"] },
    "observation_graph_ref": { "type": "string", "minLength": 1 },
    "innovations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/innovation" }
    },
    "affected_node_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "affected_edge_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "propagation_stop_edge_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "unchanged_control_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "controller_revision": { "type": "string", "minLength": 1 },
    "mapping_revision": { "type": ["string", "null"] },
    "human_audit_status": { "enum": ["not_audited", "sampled", "approved", "rejected"] },
    "provenance": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "innovation": {
      "type": "object",
      "required": [
        "innovation_id",
        "category",
        "observation_node_ids",
        "belief_node_ids",
        "evidence_reliability",
        "provenance"
      ],
      "properties": {
        "innovation_id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "matched",
            "new",
            "occluded",
            "out_of_fov",
            "reliably_absent",
            "conflict",
            "ambiguous",
            "sensor_inconsistent"
          ]
        },
        "observation_node_ids": { "type": "array", "items": { "type": "string" } },
        "belief_node_ids": { "type": "array", "items": { "type": "string" } },
        "geometry_delta": { "type": ["object", "null"], "additionalProperties": true },
        "identity_delta": { "type": ["object", "null"], "additionalProperties": true },
        "visibility_delta": { "type": ["object", "null"], "additionalProperties": true },
        "relation_deltas": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "causal_scores": { "type": "object", "additionalProperties": { "type": "number" } },
        "evidence_reliability": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "operation_id",
        "operator",
        "target_kind",
        "target_id",
        "before",
        "after",
        "evidence_refs",
        "confidence",
        "valid_from"
      ],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": [
            "REINFORCE",
            "ADD",
            "UPDATE_STATE",
            "RELINK",
            "INVALIDATE",
            "SUPERSEDE",
            "PRESERVE",
            "QUARANTINE"
          ]
        },
        "target_kind": { "enum": ["node", "edge"] },
        "target_id": { "type": "string", "minLength": 1 },
        "before": { "type": ["object", "null"], "additionalProperties": true },
        "after": { "type": ["object", "null"], "additionalProperties": true },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "valid_from": { "type": "number" },
        "valid_to": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
