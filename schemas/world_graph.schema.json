{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/embodied-memory/world_graph.schema.json",
  "title": "Versioned World Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "graph_version", "parent_version", "nodes", "edges", "transaction_log"],
  "properties": {
    "schema_version": {"const": "cpmt-0.2"},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"type": "string", "minLength": 1},
    "parent_version": {"type": ["string", "null"]},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "node_version_id", "node_type", "lifecycle", "valid_from", "evidence_refs", "latent_refs", "provenance"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "node_version_id": {"type": "string", "minLength": 1},
          "node_type": {"enum": ["entity", "surface", "place", "chart", "region"]},
          "lifecycle": {"enum": ["candidate", "confirmed", "dormant", "retracted", "alias"]},
          "valid_from": {"type": "integer", "minimum": 0},
          "valid_to": {"type": ["integer", "null"], "minimum": 0},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "latent_refs": {"type": "array", "items": {"type": "string"}},
          "canonical_id": {"type": ["string", "null"]},
          "predecessor_ids": {"type": "array", "items": {"type": "string"}},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "edge_version_id", "source", "target", "relation", "frame", "valid_from", "evidence_refs", "provenance"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "edge_version_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1},
          "frame": {"enum": ["world", "chart", "agent", "object"]},
          "valid_from": {"type": "integer", "minimum": 0},
          "valid_to": {"type": ["integer", "null"], "minimum": 0},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "transaction_log": {"type": "array", "items": {"type": "string"}},
    "graph_hash": {"type": ["string", "null"]}
  }
}
