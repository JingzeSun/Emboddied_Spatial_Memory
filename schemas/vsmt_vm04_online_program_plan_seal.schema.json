{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/embodied-memory/vsmt_vm04_online_program_plan_seal.schema.json",
  "title": "VSMT VM-04 Online Program Plan Temporal Seal",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "program": {"enum": ["NOOP", "BIND", "BIRTH", "REACTIVATE", "RELINK", "RETRACT", "SPLIT", "MERGE", "REPLACE"]},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "episode_id", "family_id", "program", "route_plan_sha256", "terminal_observation_index", "precondition_refs", "visibility_subject_seal_sha256", "matcher_config_sha256", "private_identity_used", "teacher_or_reference_transaction_used", "request_sha256"],
      "properties": {
        "schema_version": {"const": "vsmt-vm04-online-program-plan-request-v1"},
        "episode_id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "program": {"$ref": "#/$defs/program"},
        "route_plan_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_observation_index": {"type": "integer", "minimum": 1},
        "precondition_refs": {"type": "object"},
        "visibility_subject_seal_sha256": {"$ref": "#/$defs/sha256"},
        "matcher_config_sha256": {"$ref": "#/$defs/sha256"},
        "private_identity_used": {"const": false},
        "teacher_or_reference_transaction_used": {"const": false},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "episode_id", "program", "request_sha256", "route_plan_sha256", "construction_plan_sha256", "matcher_prior_memory_sha256", "matcher_config_sha256", "materializer_code_sha256", "last_completed_observation_index", "sealed_before_observation_index", "terminal_public_frame_opened_before_seal", "terminal_private_frame_opened_before_seal", "future_observation_opened_before_seal", "teacher_opened_before_seal", "reference_transaction_opened_before_seal", "private_identity_used", "request_provenance_established_by_parent_stage", "clears_episode_temporal_seal_pending", "receipt_sha256"],
      "properties": {
        "schema_version": {"const": "vsmt-vm04-online-program-plan-temporal-receipt-v1"},
        "episode_id": {"type": "string", "minLength": 1},
        "program": {"$ref": "#/$defs/program"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "route_plan_sha256": {"$ref": "#/$defs/sha256"},
        "construction_plan_sha256": {"$ref": "#/$defs/sha256"},
        "matcher_prior_memory_sha256": {"$ref": "#/$defs/sha256"},
        "matcher_config_sha256": {"$ref": "#/$defs/sha256"},
        "materializer_code_sha256": {"$ref": "#/$defs/sha256"},
        "last_completed_observation_index": {"type": "integer", "minimum": 0},
        "sealed_before_observation_index": {"type": "integer", "minimum": 1},
        "terminal_public_frame_opened_before_seal": {"const": false},
        "terminal_private_frame_opened_before_seal": {"const": false},
        "future_observation_opened_before_seal": {"const": false},
        "teacher_opened_before_seal": {"const": false},
        "reference_transaction_opened_before_seal": {"const": false},
        "private_identity_used": {"const": false},
        "request_provenance_established_by_parent_stage": {"const": false},
        "clears_episode_temporal_seal_pending": {"const": false},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
