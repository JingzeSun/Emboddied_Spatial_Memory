{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/embodied-memory/observation_region.schema.json",
  "title": "Observation Region",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region_id", "episode_id", "time_index", "frame_id", "support", "latent_ref", "visibility"],
  "properties": {
    "schema_version": {"const": "cpmt-0.2"},
    "region_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "time_index": {"type": "integer", "minimum": 0},
    "frame_id": {"type": "string", "minLength": 1},
    "chart_id": {"type": ["string", "null"]},
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "coordinates"],
      "properties": {
        "kind": {"enum": ["bbox", "mask_ref", "patch_indices"]},
        "coordinates": {"type": "array", "items": {"type": "number"}},
        "asset_ref": {"type": ["string", "null"]}
      }
    },
    "latent_ref": {"type": "string", "minLength": 1},
    "depth_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "median_m": {"type": "number", "exclusiveMinimum": 0},
        "mad_m": {"type": "number", "minimum": 0},
        "valid_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "pose_ref": {"type": ["string", "null"]},
    "visibility": {"enum": ["visible", "visible_empty", "occluded", "out_of_view", "unknown"]},
    "uncertainty": {"type": "number", "minimum": 0}
  }
}
