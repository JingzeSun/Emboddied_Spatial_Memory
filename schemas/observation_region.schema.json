{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pslm/schemas/observation_region.schema.json",
  "title": "PSLM Observation Region",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region_id", "frame_id", "timestamp", "region_type", "support", "latent_ref", "source"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "region_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "number"},
    "region_type": {"enum": ["surface", "object", "portal", "occlusion", "perspective_cue", "unknown"]},
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_bbox"],
      "properties": {
        "image_bbox": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
          "items": false
        },
        "mask_ref": {"type": ["string", "null"]},
        "depth_ref": {"type": ["string", "null"]},
        "camera_ray_ref": {"type": ["string", "null"]}
      }
    },
    "latent_ref": {"type": "string", "minLength": 1},
    "geometry_ref": {"type": ["string", "null"]},
    "semantic_hints": {"type": "array", "items": {"type": "string"}},
    "visibility": {"enum": ["visible", "partially_occluded", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_id", "tokenizer_id"],
      "properties": {
        "sensor_id": {"type": "string"},
        "tokenizer_id": {"type": "string"},
        "tokenizer_version": {"type": "string"}
      }
    },
    "oracle_world_node_id": {"type": ["string", "null"], "description": "Evaluation-only; forbidden as online model input."}
  }
}

