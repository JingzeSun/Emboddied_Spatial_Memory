{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pslm/schemas/memory_transaction.schema.json",
  "title": "PSLM Memory Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "proposed_at", "operation", "association_action", "targets", "scope", "valid_time", "evidence_ids", "confidence", "preconditions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "transaction_id": {"type": "string", "minLength": 1},
    "proposed_at": {"type": "number"},
    "operation": {"enum": ["CREATE", "REINFORCE", "UPDATE", "RELINK", "RETRACT", "REPLACE", "PRESERVE", "QUARANTINE"]},
    "association_action": {"enum": ["BIND", "NEW", "REACTIVATE", "SPLIT", "MERGE", "UNRESOLVED"]},
    "source_region_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_type", "target_id"],
        "properties": {
          "target_type": {"enum": ["node", "edge", "fact", "chart", "place", "candidate"]},
          "target_id": {"type": "string", "minLength": 1}
        }
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "relation_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "payload": {"type": "object"},
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": {"type": "number"},
        "end": {"type": ["number", "null"]}
      }
    },
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "control_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rationale_code": {"type": ["string", "null"]}
  }
}

